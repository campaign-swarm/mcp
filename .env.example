# OAuth 2.1 is enabled when OAUTH_ENCRYPTION_KEY is set.
# Generate exactly 32 random bytes, for example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Store the real value in the service's secret manager, never in git.
OAUTH_ENCRYPTION_KEY=

# Public origin and MCP resource identifier. Keep these exact: clients compare
# the protected-resource metadata resource with the URL they connected to.
MCP_PUBLIC_URL=https://mcp.campaignswarm.com
# OAUTH_ISSUER_URL=https://mcp.campaignswarm.com
# OAUTH_RESOURCE_URL=https://mcp.campaignswarm.com/mcp
# OAUTH_CONSENT_URL=https://mcp.campaignswarm.com/oauth/consent

# Persist OAuth clients, codes and token records across restarts. Use a
# deployment volume with mode 600; the file contains encrypted API-key material.
OAUTH_STATE_FILE=/var/lib/campaign-swarm/mcp-oauth.json
